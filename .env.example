# DeepSeek(对话 / 教案解析 / 记录 / 规划)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Azure 语音(国际版):识别 / 合成 / 发音评估
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# 默认使用自然多语言老师音色；跟读示范只降速，不强行升调
AZURE_TTS_VOICE_EN=en-US-AvaMultilingualNeural
AZURE_TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural

# 可选：单独的 HD TTS 资源（现有 ASR / 发音评估资源无需迁移）
# AZURE_TTS_KEY=
# AZURE_TTS_REGION=southeastasia
# AZURE_TTS_VOICE_EN=en-US-Emma2:DragonHDLatestNeural
# AZURE_TTS_VOICE_ZH=zh-CN-Xiaochen:DragonHDLatestNeural

# 家长模式 PIN(留空则用 config.json 的 pin)
PARENT_PIN=
